# Configurações do Flask
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=sua_chave_secreta_aqui

# Configuração do Banco de Dados SQL Server
# Exemplo usando Windows Authentication (Trusted_Connection):
SQLALCHEMY_DATABASE_URI="mssql+pyodbc://@Servidor/banco?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes&Encrypt=no"

# Exemplo usando Autenticação do SQL Server (usuário e senha):
# SQLALCHEMY_DATABASE_URI="mssql+pyodbc://usuario:senha@Servidor/banco?driver=ODBC+Driver+17+for+SQL+Server"

# Configuração da API do Google Gemini (LLM)
GEMINI_API_KEY=sua_chave_gemini_api_aqui
GEMINI_MODEL_NAME=gemini-2.5-flash
